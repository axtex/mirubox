diff --git a/node_modules/next/dist/client/dev/debug-channel.js b/node_modules/next/dist/client/dev/debug-channel.js
index b4f67e7..1ae3ad4 100644
--- a/node_modules/next/dist/client/dev/debug-channel.js
+++ b/node_modules/next/dist/client/dev/debug-channel.js
@@ -59,7 +59,13 @@ function wasServedFromCache() {
     try {
         // There is exactly one PerformanceNavigationTiming entry per page load.
         const entry = performance.getEntriesByType('navigation')[0];
-        return entry?.transferSize === 0;
+        if (!entry) return false;
+        // Firefox (and some WebKit cases) report transferSize===0 while a
+        // streaming response is still arriving, which falsely triggers
+        // location.reload() in a loop on Suspense pages. Only treat real
+        // cache restores as cached.
+        // See: https://github.com/vercel/next.js/pull/94128
+        return entry.type === 'back_forward' || (entry.responseStart === 0 && entry.responseEnd > 0);
     } catch  {
         return false;
     }
